# Copy to .env and fill in. .env is gitignored; never commit real keys (this repo is public).

# Claude API key from console.anthropic.com (credits from Yash)
ANTHROPIC_API_KEY=

# Anthropologic API service account (see the Anthropologic cURL guide; not the passkey web login).
# Base URL is what the web app called on 2026-10-28; the old guide lists sphere-v3-prod-…run.app.
ANTHROPOLOGIC_EMAIL=
ANTHROPOLOGIC_PASSWORD=
ANTHROPOLOGIC_TENANT_ID=
# the ?key= value in the guide's login URL
ANTHROPOLOGIC_FIREBASE_KEY=
ANTHROPOLOGIC_BASE_URL=https://api.quilt.ai/anthropologic
